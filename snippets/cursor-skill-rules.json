{
  "skills": {
    "gtd-harness": {
      "type": "workflow",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Main entry package for the GTD (David Allen) trusted system: init/capture/clarify/update/organize/engage/review. Moves tasks / commitments out of your head into the memory/gtd/ eight lists. New captures default to capture→clarify; completions / progress / replies / schedule changes go to update; knowledge / ideas go to reference.md.",
      "promptTriggers": {
        "keywords": [
          "GTD",
          "getting things done",
          "gtd-harness",
          "next actions",
          "next action",
          "update task",
          "mark done",
          "weekly review",
          "clear my head",
          "pending items",
          "what should I do",
          "my inbox",
          "inbox",
          "clarify",
          "empty my head",
          "mind sweep",
          "mind like water",
          "horizons of focus",
          "sort out my to-dos",
          "what to do this week",
          "task management system",
          "gtd help",
          "which gtd command"
        ],
        "intentPatterns": [
          "(set up|build|create|initialize).*(GTD|task system|list system)",
          "(finished|done with|bought|sent|confirmed|they replied|moved to|cancel).*(task|to-?do|project|event|meeting|appointment)?",
          "(help me|these).*(to-?dos?|tasks).*(sort|clear|organize|file)",
          "(this week|today|now).*(what to do|what should I do|what's next)",
          "(my head|my mind|I).*(mess|too much|can't remember).*(empty|sort out|organize)",
          "(weekly|week).*(review|retro).*(tasks|system|lists)",
          "(clear my head|sort through.*pending|what should I do|weekly review)"
        ]
      },
      "resources": {
        "primary": ".cursor/skills/gtd-harness/SKILL.md"
      }
    }
  }
}
